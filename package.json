{
  "name": "map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync-worker": "mkdir -p public/assets && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/assets/",
    "prebuild": "npm run sync-worker",
    "predev": "npm run sync-worker"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
